{
  "name": "portfolio",
  "compatibility_date": "2026-02-09",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "analytics_engine_datasets": [
    { "binding": "ASK_LOG", "dataset": "portfolio_ask" }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ]
}
