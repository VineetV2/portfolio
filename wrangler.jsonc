{
  "name": "portfolio",
  "compatibility_date": "2026-02-09",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // /career-ops is private: the Worker checks the Cloudflare Access login
    // before any of its files are served.
    "run_worker_first": ["/career-ops", "/career-ops/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "analytics_engine_datasets": [
    { "binding": "ASK_LOG", "dataset": "portfolio_ask" }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ]
}
